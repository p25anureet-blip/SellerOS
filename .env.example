# Copy this file to .env.local and fill in real values. Never commit .env.local.

# true = run without Supabase: no login, built-in demo seller, data kept in the browser.
DEMO_MODE=true

# ── AI providers (AI Product Agent: video → product attributes) ───────────────
# GEMINI_API_KEY is the only key needed. Auto mode uses Gemini first, then DeepSeek
# only if a valid DeepSeek key is set. Keys stay on the server. See README → "AI providers".

# Qwen (optional, manual only, not in Auto): Alibaba Cloud Model Studio → API Keys. Region-specific:
# a Singapore key needs the Singapore URL below.
QWEN_API_KEY=
# Optional. Default qwen3-vl-flash; qwen3-vl-plus is more accurate, costs more.
QWEN_MODEL=
# Optional. Default https://dashscope-intl.aliyuncs.com/compatible-mode/v1 (Singapore).
# US (Virginia): https://dashscope-us.aliyuncs.com/compatible-mode/v1
# China (Beijing): https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_BASE_URL=

# DeepSeek (optional fallback): platform.deepseek.com → API keys (prepaid). Off unless the key looks like sk-….
DEEPSEEK_API_KEY=
# Optional. Default deepseek-v4-flash-vision-exp. Must be a DeepSeek model that accepts images.
DEEPSEEK_MODEL=
# Optional. Default https://api.deepseek.com
DEEPSEEK_BASE_URL=

# Gemini (primary): Google AI Studio → Get API key.
GEMINI_API_KEY=
# Optional. Defaults to gemini-flash-lite-latest (Google's current Flash-Lite model).
# `npm run gemini:models` lists the models your key can use (e.g. gemini-flash-lite-latest).
GEMINI_MODEL=

# Supabase: only needed when DEMO_MODE is not true.
# Project Settings → API Keys (and Data API for the URL)
NEXT_PUBLIC_SUPABASE_URL=
# The "publishable" key (sb_publishable_...). Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The "secret" key (sb_secret_...). Tests only. It bypasses Row Level Security.
SUPABASE_SECRET_KEY=

# Optional: path to a product MP4 for `npm run test:integration` (real Gemini video test).
# The per-provider tests (tests/integration/providers.test.ts) use a built-in fixture.
TEST_VIDEO_PATH=
